            <column caption='Small Breed %' datatype='real' default-format='p0.0%' name='[Calculation_5441199700545545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_5441199700221960]) / COUNT([AnimalName])' />
