              <calculation class='tableau' formula='IF CONTAINS(LOWER([BreedName]), &quot;yorkshire&quot;) &#10;OR CONTAINS(LOWER([BreedName]), &quot;chihuahua&quot;)&#10;OR CONTAINS(LOWER([BreedName]), &quot;maltese&quot;)&#10;OR CONTAINS(LOWER([BreedName]), &quot;pomeranian&quot;)&#10;OR CONTAINS(LOWER([BreedName]), &quot;shih tzu&quot;)&#10;OR CONTAINS(LOWER([BreedName]), &quot;havanese&quot;)&#10;OR CONTAINS(LOWER([BreedName]), &quot;french bulldog&quot;)&#10;OR CONTAINS(LOWER([BreedName]), &quot;dachshund&quot;)&#10;OR CONTAINS(LOWER([BreedName]), &quot;bichon&quot;)&#10;OR CONTAINS(LOWER([BreedName]), &quot;miniature&quot;)&#10;OR CONTAINS(LOWER([BreedName]), &quot;toy&quot;)&#10;THEN 1&#10;ELSE 0&#10;END' />
